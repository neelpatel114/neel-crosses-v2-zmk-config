/*
 * Crosses V2 (54-key, Bridges) keymap ported from Neel's Lily58 ZMK config.
 *
 * Port notes vs the Lily58:
 *  - 4x6 matrix per side maps 1:1. Every alpha, number, and outer-column key is unchanged.
 *  - Lily58 had 4 thumbs per side; Crosses has 3. Dropped LALT (left outer) and RGUI (right outer).
 *    Left thumb LGUI became a layer-tap: tap = LGUI, hold = Mouse layer (3), matching the GGGW default.
 *  - Lily58's inner bottom-row [ and ] keys do not exist here. Brackets live on Raise, same
 *    positions as before (C/V = [ ], E/R = { }).
 *  - Encoder sensor-bindings removed (no encoder on Crosses).
 *  - Bluetooth: tap BT0-4 selects a profile, hold it 1 s forgets that profile's host.
 *    The dedicated BT_CLR key is gone.
 *  - Shift+Backspace sends Delete (mod-morph on the right thumb).
 *  - Lower outer key toggles USB vs Bluetooth output.
 *  - Left ball defaults to Scroll, right ball to Cursor (default-index overrides).
 *  - Auto mouse layer: ball motion activates layer 3 for 750 ms (see overrides above the root node).
 *  - Mouse layer added as layer 3 with clicks on both home rows so either hand can click
 *    while the other thumb drives a ball. studio_unlock is top-left on that layer (GGGW default).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

// Auto mouse layer: any ball movement turns on layer 3 (Mouse) for 750 ms after the
// last motion, so S/D/F and J/K/L become clicks while pointing. It will not activate
// if a key was pressed in the last 200 ms, so brushing the ball mid-typing does nothing.
&zip_temp_layer {
    require-prior-idle-ms = <200>;
};
&trackball_central_listener {
    input-processors = <&zip_central_ball>, <&zip_temp_layer 3 750>;
};
&trackball_peripheral_listener {
    input-processors = <&zip_temp_layer 3 750>;
};

// Ball roles: left ball scrolls, right ball moves the cursor.
// Pipeline index: 0 = Cursor, 1 = Scroll, 2 = Scroll with Y inverted.
// If scroll direction feels backwards, change the left one to <2>.
// Note: the modes are persistent; a choice made later in the tuning app overrides these defaults.
&zip_periph_ball  { default-index = <1>; };
&zip_central_ball { default-index = <0>; };

/ {
    chosen { zmk,physical-layout = &gggw_crosses_54_layout; };

    macros {
        // Select profile N (one-param wrapper so it can live inside a hold-tap)
        bt_sel: bt_sel {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2>, <&bt BT_SEL MACRO_PLACEHOLDER>;
        };
        // Select profile N, then clear it (BT_CLR only ever clears the active profile)
        bt_clr_prof: bt_clr_prof {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <50>;
            bindings = <&macro_param_1to2>, <&bt BT_SEL MACRO_PLACEHOLDER>, <&bt BT_CLR>;
        };
    };

    behaviors {
        // Shift+Backspace = Delete (shift is not passed through)
        bspc_del: bspc_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // Tap: switch to profile N. Hold 1 s: forget the host paired on profile N.
        // Use as &bt_ht N N
        bt_ht: bt_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <1000>;
            bindings = <&bt_clr_prof>, <&bt_sel>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3  |  4  |  5  |      |  6  |  7  |  8  |  9  |  0  |   =   |
            // |  TAB  |  Q  |  W  |  E  |  R  |  T  |      |  Y  |  U  |  I  |  O  |  P  |   -   |
            // | CTRL  |  A  |  S  |  D  |  F  |  G  |      |  H  |  J  |  K  |  L  |  ;  |   '   |
            // | SHIFT |  Z  |  X  |  C  |  V  |  B  |      |  N  |  M  |  ,  |  .  |  /  | SHIFT |
            //             | GUI/Mouse | LOWER | SPACE |  | ENTER | RAISE | BSPC (shift = DEL) |
            display-name = "Base";
            bindings = <
&kp ESC           &kp N1  &kp N2  &kp N3  &kp N4  &kp N5       &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp EQUAL
&kp TAB           &kp Q   &kp W   &kp E   &kp R   &kp T        &kp Y   &kp U   &kp I      &kp O    &kp P     &kp MINUS
&kp LEFT_CONTROL  &kp A   &kp S   &kp D   &kp F   &kp G        &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT    &kp Z   &kp X   &kp C   &kp V   &kp B        &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                          &lt 3 LGUI  &mo 1  &kp SPACE         &kp RET  &mo 2  &bspc_del
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------
            // |   ~   |     |     |     |     |     |      |     |     |     | VOL- | VOL+ | PLAY  |
            // |USB/BT | BT0 | BT1 | BT2 | BT3 | BT4 |  (tap = select, hold 1s = clear that profile)      |  7  |  8  |  9  |  +   |  =   | BSPC  |
            // |  F1   | F2  | F3  | F4  | F5  | F6  |      |  4  |  5  |  6  |  -   |  UP  |   ~   |
            // |  F7   | F8  | F9  | F10 | F11 | F12 |      |  1  |  2  |  3  | LEFT | DOWN | RIGHT |
            //             | CTRL | ___ | SPACE |  | ENTER |  0  | ALT |
            display-name = "Lower";
            bindings = <
&kp TILDE   &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_PLAY_PAUSE
&out OUT_TOG  &bt_ht 0 0    &bt_ht 1 1    &bt_ht 2 2    &bt_ht 3 3    &bt_ht 4 4        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS           &kp EQUAL        &kp BACKSPACE
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5        &kp F6            &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS          &kp UP_ARROW     &kp TILDE
&kp F7      &kp F8        &kp F9        &kp F10       &kp F11       &kp F12           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp LEFT           &kp DOWN         &kp RIGHT
                          &kp LEFT_CONTROL  &trans  &kp SPACE                          &kp ENTER  &kp NUMBER_0  &kp RIGHT_ALT
            >;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------
            // |      |     |     |     |     |     |      |      |     |     |     |     |      |
            // |  `   |  !  |  @  |  #  |  $  |  %  |      | CTRL |  &  |  *  |  -  |  +  | BSPC |
            // | SHFT |  (  |  )  |  {  |  }  |  |  |      | LEFT | DOWN| UP  |RIGHT|C-UP |  `   |
            // | CTRL |  <  |  >  |  [  |  ]  |  "  |      |  KP+ |  -  |  =  |  |  |  ?  |  \   |
            //             | CTRL | ALT | CMD |  | C-LEFT | ___ | C-RIGHT |
            display-name = "Raise";
            bindings = <
&trans            &trans           &trans            &trans            &trans             &trans               &trans       &trans         &trans        &trans     &trans            &trans
&kp GRAVE         &kp EXCLAMATION  &kp AT_SIGN       &kp HASH          &kp DOLLAR         &kp PERCENT          &kp LCTRL    &kp AMPERSAND  &kp ASTERISK  &kp MINUS  &kp PLUS          &kp BACKSPACE
&kp LEFT_SHIFT    &kp LPAR         &kp RPAR          &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp PIPE             &kp LEFT     &kp DOWN       &kp UP_ARROW  &kp RIGHT  &kp LC(UP_ARROW)  &kp GRAVE
&kp LEFT_CONTROL  &kp LESS_THAN    &kp GREATER_THAN  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp DOUBLE_QUOTES    &kp KP_PLUS  &kp MINUS      &kp EQUAL     &kp PIPE   &kp QUESTION      &kp BSLH
                                   &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_COMMAND                            &kp LC(LEFT)  &trans  &kp LC(RIGHT)
            >;
        };

        mouse_layer {
            // Held via the left outer thumb (GUI). Clicks on both home rows:
            // Index = left click, middle finger = right click, ring = middle click, pinky = back/forward.
            // Left hand A/S/D/F = back/middle/right/left; right hand J/K/L/; = left/right/middle/forward.
            display-name = "Mouse";
            bindings = <
&studio_unlock  &trans  &trans     &trans     &trans     &trans       &trans  &trans     &trans     &trans     &trans  &trans
&trans          &trans  &trans     &trans     &trans     &trans       &trans  &trans     &trans     &trans     &trans  &trans
&trans          &mkp MB4  &mkp MCLK  &mkp RCLK  &mkp LCLK  &trans       &trans  &mkp LCLK  &mkp RCLK  &mkp MCLK  &mkp MB5  &trans
&trans          &trans  &trans     &trans     &trans     &trans       &trans  &trans     &trans     &trans     &trans  &trans
                                   &trans  &trans  &trans               &trans  &trans  &trans
            >;
        };
    };
};
